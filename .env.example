# Chat widget (optional)
CHAT_API_KEY=sk-ant-...

# Chat rate limiting (optional) — Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Admin (optional) — unlocks /admin. See SETUP-ADMIN.md.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# BETTER_AUTH_SECRET=        # openssl rand -base64 32
# BETTER_AUTH_URL=https://ruslanshulga.com
# OWNER_EMAIL=you@example.com          # always allowed, never needs to be in the list below
# ADMIN_ALLOWLIST=a@x.com,b@y.com      # everyone else allowed to sign in / register
# GOOGLE_CLIENT_ID=                    # from Google Cloud → OAuth client (Web app)
# GOOGLE_CLIENT_SECRET=                # enables the "Continue with Google" button

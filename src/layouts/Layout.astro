---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CustomCursor from '../components/islands/CustomCursor';
import CommandPalette from '../components/islands/CommandPalette';
import AskMe from '../components/islands/AskMe';
import { about } from '../data/about';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ruslan Shulga — AI Platform Engineer',
  description = 'VP Engineering at JPMorgan Chase. I build production AI platforms used by thousands of internal users every day.',
} = Astro.props;

const siteBase = Astro.site ?? new URL(about.portfolio);
const canonical = new URL(Astro.url.pathname, siteBase).toString();
const ogImage = new URL('/og.png', siteBase).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: about.name,
  url: about.portfolio,
  jobTitle: about.role,
  worksFor: { '@type': 'Organization', name: about.company },
  address: { '@type': 'PostalAddress', addressLocality: about.location },
  email: `mailto:${about.email}`,
  sameAs: [about.linkedin, about.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#08090a" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div data-preloader aria-hidden="true">
      <span class="preloader-name">
        {'RUSLAN SHULGA'.split('').map((c, i) => (
          <span class="preloader-char" style={`--char-delay: ${0.1 + i * 0.03}s`}>{c === ' ' ? ' ' : c}</span>
        ))}
      </span>
    </div>
    <slot />
    <CustomCursor client:only="react" />
    <CommandPalette client:only="react" />
    <AskMe client:only="react" />

    <script>
      // Remove preloader after CSS animation completes (safety + cleanup)
      function cleanPreloader() {
        const el = document.querySelector('[data-preloader]') as HTMLElement | null;
        if (!el) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) { el.remove(); return; }
        // CSS animation runs ~2.1s (1.4s delay + 0.7s slide). Remove DOM node after.
        setTimeout(() => { if (el.parentNode) el.remove(); }, 2500);
      }
      cleanPreloader();
      document.addEventListener('astro:after-swap', () => {
        const pre = document.querySelector('[data-preloader]') as HTMLElement | null;
        if (pre) pre.remove();
      });
    </script>

    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;
      let rafStarted = false;

      // One rAF loop for the whole session. initLenis runs again on every
      // view-transition swap; starting a loop per call would stack loops and
      // drive lenis.raf N times a frame after N navigations.
      function startRafLoop() {
        if (rafStarted) return;
        rafStarted = true;
        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      function initLenis() {
        if (lenis) lenis.destroy();
        lenis = null;
        (window as any).__lenis = null;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;
        lenis = new Lenis({ duration: 1.15, smoothWheel: true });
        // expose for GSAP ScrollTrigger sync
        (window as any).__lenis = lenis;
        startRafLoop();
      }

      initLenis();
      document.addEventListener('astro:after-swap', initLenis);

      // Magnetic CTAs — delegated at the document so they work on every page
      // and survive view-transition swaps (per-element listeners die with the
      // old DOM). Pointer devices with motion allowed only.
      if (
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.addEventListener(
          'mousemove',
          (e) => {
            const el = (e.target as HTMLElement | null)?.closest?.<HTMLElement>('[data-magnetic]');
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const mx = e.clientX - (rect.left + rect.width / 2);
            const my = e.clientY - (rect.top + rect.height / 2);
            el.style.transform = `translate(${mx * 0.25}px, ${my * 0.25}px)`;
          },
          { passive: true }
        );
        document.addEventListener('mouseout', (e) => {
          const el = (e.target as HTMLElement | null)?.closest?.<HTMLElement>('[data-magnetic]');
          if (el && !el.contains(e.relatedTarget as Node | null)) el.style.transform = '';
        });
      }

      // Console easter egg
      const ascii = `
   ╭─◉─╮      ╭─◉─╮
   │   │╲    ╱│   │
   ╰─◉─╯ ╲  ╱ ╰─◉─╯
        ╲╲╱╱
         ◉   ← multi-agent orchestration, in your terminal
        ╱╱╲╲
   ╭─◉─╯  ╲  ╱  ╰─◉─╮
   │   │   ╲╱   │   │
   ╰─◉─╯        ╰─◉─╯
`;
      console.log(
        '%c' + ascii,
        'color: #8a8f98; font-family: monospace; font-size: 11px; line-height: 1.2;'
      );
      console.log(
        '%cif you are reading this we should talk → %cnycruslan@gmail.com',
        'color: #5e6469; font-family: monospace;',
        'color: #e6e7e8; font-family: monospace; text-decoration: underline;'
      );
    </script>
  </body>
</html>

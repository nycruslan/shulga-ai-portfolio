---
// A WAI-ARIA tab strip for the admin decks.
//
// Server-rendered: the panels are plain slots, so Astro-rendered content stays
// Astro-rendered and only the islands inside a panel ship JS. The behaviour is
// ~40 lines of inline script rather than a framework island, because tabs are
// three DOM properties and the ARIA pattern is fully specified.
//
// The active tab lives in the URL (?view=positions) via replaceState, so a view
// is linkable and survives reload without adding a history entry per click.
interface Tab {
  id: string;
  label: string;
  count?: number;
}
interface Props {
  tabs: Tab[];
  /** Fallback when the URL carries no (or an unknown) ?view. */
  initial?: string;
  param?: string;
}
const { tabs, initial = tabs[0]?.id, param = 'view' } = Astro.props;

// Resolve the active tab on the server so the correct panel is in the initial
// HTML. Without this the first paint shows panel 1 and then swaps, which is a
// visible flash on every load of a deep link.
const requested = Astro.url.searchParams.get(param);
const active = tabs.some((t) => t.id === requested) ? requested! : initial;

// `<slot name={expr}/>` is a compile error in Astro — slot names must be static
// strings. Rendering each named slot to HTML here is the supported way to build
// panels from a dynamic tab list. Islands inside a slot still hydrate normally,
// because this goes through the ordinary render pipeline.
const panels = await Promise.all(
  tabs.map(async (t) => ({
    ...t,
    html: Astro.slots.has(t.id) ? await Astro.slots.render(t.id) : '',
  })),
);
---

<div class="deck-tabs mt-6" data-param={param}>
  <div
    role="tablist"
    aria-label="Trader detail views"
    class="flex flex-wrap items-center gap-1 border-b border-border"
  >
    {
      tabs.map((t) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={t.id === active ? 'true' : 'false'}
          tabindex={t.id === active ? 0 : -1}
          data-tab={t.id}
          class="-mb-px inline-flex items-center gap-1.5 border-b-2 px-3 py-2 font-mono text-xs uppercase tracking-wider transition-colors aria-selected:border-accent aria-selected:text-text border-transparent text-text-subtle hover:text-text"
        >
          {t.label}
          {t.count != null && (
            <span class="rounded-full bg-white/[0.06] px-1.5 py-0.5 text-[11px] tabular-nums">
              {t.count}
            </span>
          )}
        </button>
      ))
    }
  </div>

  {
    panels.map((t) => (
      <div
        role="tabpanel"
        id={`panel-${t.id}`}
        aria-labelledby={`tab-${t.id}`}
        data-panel={t.id}
        hidden={t.id !== active}
        tabindex="0"
        class="rounded-lg pt-5 outline-none focus-visible:ring-2 focus-visible:ring-accent/70"
      >
        <Fragment set:html={t.html} />
      </div>
    ))
  }
</div>

<script>
  // Scoped per instance so more than one deck can live on a page.
  document.querySelectorAll<HTMLElement>('.deck-tabs').forEach((root) => {
    const param = root.dataset.param || 'view';
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    function select(id: string, { focus = false } = {}) {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        // Roving tabindex: only the selected tab is in the tab order, so Tab
        // moves past the strip instead of through every tab in it.
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });

      const url = new URL(location.href);
      url.searchParams.set(param, id);
      history.replaceState(history.state, '', url);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => select(tab.dataset.tab!));
      tab.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(tab);
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next].dataset.tab!, { focus: true });
      });
    });
  });
</script>

<style>
  /* Off-screen panels still cost layout and paint on a page with 130+ table
     rows. content-visibility skips that work while keeping the element in the
     box tree; the intrinsic size stops the scrollbar jumping when it swaps in.
     Pairing the two is mandatory — without contain-intrinsic-size the panel
     collapses to 0px and the page shifts under the reader. */
  [role='tabpanel']:not([hidden]) {
    content-visibility: auto;
    contain-intrinsic-size: auto none auto 600px;
  }
</style>

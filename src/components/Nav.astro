---
// Root-relative so they work from subpages (/evals, /work/*) too.
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/evals', label: 'Evals' },
  { href: '/#contact', label: 'Contact' },
];
---

<nav
  class="sticky top-0 z-50"
  style="background: color-mix(in srgb, var(--color-bg) 78%, transparent); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%);"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
    style="border-bottom: 1px solid var(--color-border);"
  >
    <a href="#top" class="font-mono text-sm tracking-tight" style="color: var(--color-text);">
      ruslanshulga.com
    </a>
    <ul class="flex gap-7 text-sm" style="color: var(--color-text-muted);">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:[color:var(--color-text)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

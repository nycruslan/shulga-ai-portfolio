---
import { getCollection } from 'astro:content';

const all = await getCollection('work');
const projects = all.sort((a, b) => a.data.order - b.data.order);
---

<section
  id="work"
  class="mx-auto max-w-5xl px-6 py-24"
  style="border-top: 1px solid var(--color-border);"
>
  <p
    class="mb-12 font-mono text-xs tracking-widest uppercase"
    style="color: var(--color-text-subtle);"
    data-section-reveal
  >
    Selected Work
  </p>

  <ol class="space-y-px" id="work-list" data-spotlight-list>
    {
      projects.map((project, i) => (
        <li
          class="group block py-9 transition-colors"
          style="border-top: 1px solid var(--color-border);"
          data-project-card
          data-spotlight
          data-shape={project.data.shape}
        >
          <a href={`/work/${project.id}`} class="block">
            <article class="grid gap-6 md:grid-cols-[80px_1fr]">
              <span
                class="font-mono text-sm pt-2 transition-colors group-hover:[color:var(--color-accent)]"
                style="color: var(--color-text-subtle);"
                transition:name={`work-num-${project.id}`}
              >
                {String(i + 1).padStart(2, '0')}
              </span>

              <div>
                <h3
                  class="font-display text-2xl font-medium md:text-[2rem] md:leading-tight group-hover:[color:var(--color-text-muted)] transition-colors"
                  style="color: var(--color-text); letter-spacing: -0.015em;"
                  transition:name={`work-title-${project.id}`}
                >
                  {project.data.title}
                </h3>

                <p
                  class="mt-3 max-w-2xl leading-relaxed"
                  style="color: var(--color-text-muted);"
                >
                  {project.data.blurb}
                </p>

                <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs" data-stack>
                  {project.data.stack.map((tech) => (
                    <span style="color: var(--color-text-subtle);" data-tag>
                      {tech}
                    </span>
                  ))}
                </div>

                {project.data.metrics.length > 0 && (
                  <dl class="mt-7 flex flex-wrap items-end gap-x-12 gap-y-4" data-metrics>
                    {project.data.metrics.map((m) => (
                      <div>
                        <dt
                          class="font-mono text-xs uppercase tracking-wider"
                          style="color: var(--color-text-subtle);"
                        >
                          {m.label}
                        </dt>
                        {/* Big numerals only earn the display scale; prose values stay quiet. */}
                        <dd
                          class={
                            m.value.length <= 12
                              ? 'mt-1.5 font-mono text-2xl tabular-nums md:text-3xl'
                              : 'mt-1.5 font-mono text-base tabular-nums'
                          }
                          style="color: var(--color-text); letter-spacing: -0.01em;"
                          data-metric-value={m.value}
                        >
                          {m.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="mt-6 font-mono text-xs transition-colors group-hover:[color:var(--color-text)]" style="color: var(--color-text-subtle);">
                  Read case study →
                </div>
              </div>
            </article>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let lenisSynced = false;

  // Keep ScrollTrigger in step with Lenis. Layout's single rAF loop is the
  // only thing driving lenis.raf — adding a gsap.ticker driver here would
  // advance the scroll animation twice per frame and stack callbacks on
  // every view-transition swap.
  function syncLenis() {
    if (lenisSynced) return;
    const lenis = (window as any).__lenis;
    if (!lenis) return;
    lenis.on('scroll', () => ScrollTrigger.update());
    lenisSynced = true;
  }

  // Feed the CSS spotlight (--mx/--my) with the pointer position per row.
  function initSpotlight() {
    if (!window.matchMedia('(hover: hover)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((row) => {
      row.addEventListener('mousemove', (e) => {
        const rect = row.getBoundingClientRect();
        row.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        row.style.setProperty('--my', `${e.clientY - rect.top}px`);
      }, { passive: true });
    });
  }

  function init() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

    initSpotlight();

    if (reduced) {
      cards.forEach((el) => el.classList.add('is-in'));
      return;
    }

    syncLenis();

    cards.forEach((card) => {
      ScrollTrigger.create({
        trigger: card,
        start: 'top 88%',
        once: true,
        onEnter: () => card.classList.add('is-in'),
      });

      const tags = card.querySelectorAll<HTMLElement>('[data-tag]');
      if (tags.length) {
        gsap.set(tags, { opacity: 0, y: 8 });
        ScrollTrigger.create({
          trigger: card,
          start: 'top 85%',
          once: true,
          onEnter: () =>
            gsap.to(tags, { opacity: 1, y: 0, duration: 0.5, stagger: 0.04, ease: 'power2.out' }),
        });
      }

      const metricEls = card.querySelectorAll<HTMLElement>('[data-metric-value]');
      metricEls.forEach((el) => {
        const raw = el.dataset.metricValue || '';
        const numMatch = raw.match(/(-?\d+(?:\.\d+)?)/);
        if (!numMatch) return;
        const finalNum = parseFloat(numMatch[1]);
        const prefix = raw.substring(0, numMatch.index!);
        const suffix = raw.substring(numMatch.index! + numMatch[1].length);
        const isInt = finalNum % 1 === 0;
        ScrollTrigger.create({
          trigger: card,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            const obj = { val: 0 };
            gsap.to(obj, {
              val: finalNum,
              duration: 1.4,
              ease: 'power2.out',
              onUpdate: () => {
                const v = isInt ? Math.round(obj.val) : obj.val.toFixed(1);
                el.textContent = `${prefix}${v}${suffix}`;
              },
            });
          },
        });
      });
    });

    // Section heading reveals (About, Selected Work, Contact)
    document.querySelectorAll<HTMLElement>('[data-section-reveal]').forEach((el) => {
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () => el.classList.add('is-in'),
      });
    });

    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  init();
  document.addEventListener('astro:after-swap', () => {
    ScrollTrigger.getAll().forEach((s) => s.kill());
    lenisSynced = false;
    init();
  });
</script>

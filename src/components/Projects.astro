---
import { projects } from '../data/projects';
---

<section
  id="work"
  class="mx-auto max-w-5xl px-6 py-24"
  style="border-top: 1px solid var(--color-border);"
>
  <p
    class="mb-12 font-mono text-xs tracking-widest uppercase"
    style="color: var(--color-text-subtle);"
  >
    Selected Work
  </p>

  <ol class="space-y-px">
    {
      projects.map((project, i) => (
        <li
          class="group block py-8 transition-colors"
          style="border-top: 1px solid var(--color-border);"
        >
          <article class="grid gap-6 md:grid-cols-[80px_1fr]">
            <span
              class="font-mono text-sm pt-1"
              style="color: var(--color-text-subtle);"
            >
              {String(i + 1).padStart(2, '0')}
            </span>

            <div>
              <h3
                class="text-xl font-medium md:text-2xl"
                style="color: var(--color-text); letter-spacing: -0.01em;"
              >
                {project.title}
              </h3>

              <p
                class="mt-3 max-w-2xl leading-relaxed"
                style="color: var(--color-text-muted);"
              >
                {project.blurb}
              </p>

              <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
                {project.stack.map((tech) => (
                  <span style="color: var(--color-text-subtle);">{tech}</span>
                ))}
              </div>

              {project.metrics.length > 0 && (
                <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3 text-sm">
                  {project.metrics.map((m) => (
                    <div>
                      <dt
                        class="font-mono text-xs uppercase tracking-wider"
                        style="color: var(--color-text-subtle);"
                      >
                        {m.label}
                      </dt>
                      <dd
                        class="mt-1 font-mono"
                        style="color: var(--color-text);"
                      >
                        {m.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

---
import { about } from '../data/about';

// Single source of truth is about.ts. Strip protocol/www/trailing slash for display.
const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const links = [
  { label: 'LinkedIn', href: about.linkedin, value: shortUrl(about.linkedin) },
  { label: 'GitHub', href: about.github, value: shortUrl(about.github) },
  { label: 'Location', href: null, value: about.location },
];
---

<section
  id="contact"
  class="mx-auto max-w-5xl px-6 py-24 pb-40"
  style="border-top: 1px solid var(--color-border);"
>
  <p
    class="mb-12 font-mono text-xs tracking-widest uppercase"
    style="color: var(--color-text-subtle);"
    data-section-reveal
  >
    Contact
  </p>

  <div class="grid gap-12 md:grid-cols-[1fr_2fr]">
    <h2
      class="font-display text-2xl font-medium md:text-3xl"
      style="color: var(--color-text); letter-spacing: -0.01em;"
      data-section-reveal
    >
      Working on something interesting? Let's talk.
    </h2>

    <div>
      <!-- The email is the moment: display type, copies on click. -->
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <a
          href={`mailto:${about.email}`}
          class="font-display text-2xl font-medium underline decoration-1 underline-offset-8 transition-colors sm:text-3xl md:text-4xl hover:[text-decoration-color:var(--color-accent)]"
          style="color: var(--color-text); letter-spacing: -0.015em; text-decoration-color: var(--color-border-strong);"
        >
          {about.email}
        </a>
        <button
          type="button"
          data-copy-email={about.email}
          class="font-mono text-xs transition-colors hover:[color:var(--color-text)]"
          style="color: var(--color-text-subtle);"
        >
          copy
        </button>
      </div>

      <dl class="mt-10 space-y-5">
        {
          links.map((link) => (
            <div class="flex items-baseline gap-6">
              <dt
                class="w-20 font-mono text-xs uppercase tracking-wider"
                style="color: var(--color-text-subtle);"
              >
                {link.label}
              </dt>
              <dd class="font-mono text-sm" style="color: var(--color-text);">
                {link.href ? (
                  <a
                    href={link.href}
                    class="transition-colors hover:[color:var(--color-text-muted)]"
                  >
                    {link.value} ↗
                  </a>
                ) : (
                  link.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  // Click-to-copy with a "copied ✓" state (email + MCP endpoint).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
      '[data-copy-email], [data-copy-value]'
    );
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copyEmail || btn.dataset.copyValue || '');
      const prev = btn.textContent;
      btn.textContent = 'copied ✓';
      btn.style.color = 'var(--color-accent)';
      setTimeout(() => {
        btn.textContent = prev;
        btn.style.color = '';
      }, 1500);
    } catch {
      /* clipboard blocked — the links still work */
    }
  });
</script>

<!-- Wired for agents: the machine-readable surfaces, advertised to humans. -->
<section
  class="mx-auto max-w-5xl px-6 py-14"
  style="border-top: 1px solid var(--color-border);"
  aria-label="Machine-readable endpoints"
>
  <div class="rounded-2xl border p-6 md:p-8" style="border-color: var(--color-border); background: rgba(255,255,255,0.015);">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-text-subtle);">
        <span class="live-dot mr-2 inline-block size-1.5 rounded-full align-middle" style="background: var(--color-accent);"></span>
        Wired for agents
      </span>
      <span class="text-sm" style="color: var(--color-text-muted);">
        This portfolio is machine-readable. Bring your own AI.
      </span>
    </div>

    <dl class="mt-6 grid gap-4 font-mono text-sm md:grid-cols-3">
      <div>
        <dt class="text-[11px] uppercase tracking-wider" style="color: var(--color-text-subtle);">MCP server</dt>
        <dd class="mt-1 flex items-center gap-2">
          <button
            type="button"
            data-copy-value="https://ruslanshulga.com/api/mcp"
            title="Copy MCP endpoint"
            class="truncate text-left transition-colors hover:[color:var(--color-text)]"
            style="color: var(--color-text-muted);"
          >/api/mcp</button>
          <span class="text-[11px]" style="color: var(--color-text-subtle);">click to copy</span>
        </dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-wider" style="color: var(--color-text-subtle);">For LLMs</dt>
        <dd class="mt-1">
          <a href="/llms.txt" class="transition-colors hover:[color:var(--color-text)]" style="color: var(--color-text-muted);">/llms.txt ↗</a>
        </dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-wider" style="color: var(--color-text-subtle);">JSON resume</dt>
        <dd class="mt-1">
          <a href="/api/me.json" class="transition-colors hover:[color:var(--color-text)]" style="color: var(--color-text-muted);">/api/me.json ↗</a>
        </dd>
      </div>
    </dl>

    <p class="mt-6 text-[13px] leading-relaxed" style="color: var(--color-text-subtle);">
      Add the MCP endpoint to Claude under Settings → Connectors, or drop it in your editor's
      mcp.json. Six read-only tools, no auth. The chat on this site runs the same toolset and
      shows you its calls. Nightly quality scores live at <a href="/evals" class="transition-colors hover:[color:var(--color-accent)]" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 4px;">/evals</a>.
    </p>
  </div>
</section>

<footer
  class="mx-auto max-w-5xl px-6 py-8 font-mono text-xs"
  style="border-top: 1px solid var(--color-border); color: var(--color-text-subtle);"
>
  <span>© {new Date().getFullYear()} Ruslan Shulga</span>
</footer>

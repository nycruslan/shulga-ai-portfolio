---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SubstrateView from '../components/islands/SubstrateView.tsx';
import { isConfigured as gardenConfigured, readState as gardenReadState } from '../lib/garden/store';

// The Substrate: an AI platform rendered as a living, crewed vessel. Each role
// is a real piece of the stack, so the simulation doubles as a work sample.

// A society of agents also lives next door in the Garden. Surface the headcount
// so the two worlds read as one organism.
const gardenRow = gardenConfigured() ? await gardenReadState() : null;
const gardenPop = gardenRow ? gardenRow.state.agents.filter((a) => a.alive).length : 0;
const legend = [
  ['HELM', 'orchestrator', "Assigns and routes the crew's work. The orchestration layer."],
  ['IDX-1 / IDX-2', 'retrievers', "Pull context from the Memory Core. That's hybrid RAG."],
  ['GATEWAY', 'tool gateway', 'Calls external tools through MCP.'],
  ['ARBITER', 'eval judge', 'Scores every output. The eval harness.'],
  ['WARDEN', 'supervisor', 'Quarantines and restarts agents that fail. The fail-safe.'],
];
---

<Layout
  title="The Substrate · Ruslan Shulga"
  description="A live, shared AI platform rendered as a crewed vessel: an orchestrator routes work, retrievers query a memory core, an eval judge scores outputs, and a supervisor quarantines failing agents. Watch it, and perturb it."
>
  <Nav />
  <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-6 pt-20 pb-28 md:pt-28">
    <p class="mb-6 font-mono text-xs tracking-widest uppercase" style="color: var(--color-text-subtle);">
      The Substrate
    </p>

    <h1 class="font-display max-w-3xl text-3xl font-medium md:text-5xl" style="color: var(--color-text); letter-spacing: -0.02em;">
      An AI platform you can watch breathe.
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-relaxed md:text-lg" style="color: var(--color-text-muted);">
      One shared world, live for everyone. An orchestrator routes work to the crew, retrievers
      query a memory core, an eval judge scores every output, and a supervisor quarantines and
      restarts agents that fail. It's the stack I build, rendered as an organism. It sleeps when
      no one is looking, and wakes when you are.
    </p>

    <div class="mt-10">
      <SubstrateView client:load />
    </div>

    {
      gardenRow && (
        <a
          href="/garden"
          class="group mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border p-4 transition-colors hover:[border-color:var(--color-accent)]"
          style="border-color: var(--color-border); background: rgba(255,255,255,0.015);"
        >
          <span class="font-display text-2xl font-medium tabular-nums" style="color: var(--color-text);">
            {gardenPop}
          </span>
          <span class="text-sm" style="color: var(--color-text-muted);">
            small AI creatures live next door in the Garden. They talk, bond, and raise new ones on their own.
          </span>
          <span class="ml-auto font-mono text-sm transition-transform group-hover:translate-x-0.5" style="color: var(--color-accent);">
            Visit the Garden →
          </span>
        </a>
      )
    }

    <section class="mt-14">
      <h2 class="font-display text-xl font-medium md:text-2xl" style="color: var(--color-text);">
        Every system on screen is real
      </h2>
      <p class="mt-2 max-w-2xl text-sm" style="color: var(--color-text-muted);">
        This isn't a cartoon. The pipeline, the scoring, and the failover are the same shapes I
        ship in production. The crew is labeled so you can read it as the architecture it is.
      </p>
      <dl class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          legend.map(([who, role, what]) => (
            <div class="rounded-xl border p-4" style="border-color: var(--color-border); background: rgba(255,255,255,0.015);">
              <dt class="font-mono text-sm" style="color: var(--color-text);">
                {who} <span style="color: var(--color-text-subtle);">· {role}</span>
              </dt>
              <dd class="mt-1 text-sm" style="color: var(--color-text-muted);">{what}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="mt-12 font-mono text-xs" style="color: var(--color-text-subtle);">
      Cheap by design: a deterministic simulation runs free, and Claude only adds the crew's voice
      on a budget-capped tick. Visitor actions queue and resolve on the next tick, so they never
      cost a synchronous model call.
    </p>
  </main>
</Layout>

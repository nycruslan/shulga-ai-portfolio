---
export const prerender = false;
import AdminShell from '../../layouts/AdminShell.astro';
import JobHuntDashboard from '../../components/admin/JobHuntDashboard.tsx';
import { readSnapshot } from '../../lib/turso';

// Middleware guarantees only the owner reaches this route. Never cache: the
// dashboard reflects the latest publish from the jobhunt tool.
Astro.response.headers.set('Cache-Control', 'no-store');
const snap = await readSnapshot();
---

<AdminShell title="JobHunt">
  {
    !snap ? (
      <p class="text-text-muted mt-8 text-sm">
        No snapshot yet. Run a feed pull with publishing enabled (
        <code class="text-text-subtle font-mono">preferences.publish: true</code> + Turso creds).
      </p>
    ) : (
      <JobHuntDashboard client:load initial={snap} />
    )
  }
</AdminShell>

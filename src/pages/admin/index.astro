---
export const prerender = false;
import '../../styles/global.css';
import AdminTables from '../../components/admin/AdminTables.tsx';
import { readSnapshot } from '../../lib/turso';

// Middleware guarantees only the owner reaches this route.
const user = Astro.locals.user;
const snap = await readSnapshot();

const STATUS_ORDER = [
  'new',
  'reviewed',
  'drafted',
  'applied',
  'screen',
  'onsite',
  'offer',
  'rejected',
];
const pipeline = snap
  ? STATUS_ORDER.filter((s) => snap.pipeline[s]).map((s) => [s, snap.pipeline[s]] as const)
  : [];
const updated = snap ? new Date(snap.generated_at).toLocaleString() : null;

const funnel = snap?.funnel;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>JobHunt · Admin</title>
    <!-- Admin has no custom-cursor island, so restore the native cursor that global.css hides. -->
    <style is:global>
      @media (pointer: fine) {
        html * {
          cursor: auto !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <header class="sticky top-0 z-20 border-b border-border bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-sm font-medium uppercase tracking-[0.18em]">JobHunt</span>
          {
            updated && (
              <span class="hidden text-xs text-text-subtle sm:inline">updated {updated}</span>
            )
          }
        </div>
        <div class="flex items-center gap-3 text-xs text-text-muted">
          <a
            href="/admin/trader"
            class="hidden text-text-muted underline-offset-4 hover:text-text hover:underline sm:inline"
            >AI Trader →</a
          >
          <span class="hidden sm:inline">{user?.email}</span>
          <button
            id="logout"
            class="rounded-lg border border-border-strong px-3 py-1.5 text-text-muted transition-colors hover:bg-white/[0.04] hover:text-text"
            >Sign out</button
          >
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 pb-24 pt-7">
      {
        !snap ? (
          <p class="mt-8 text-sm text-text-muted">
            No snapshot yet. Run a feed pull with publishing enabled (
            <code class="font-mono text-text-subtle">preferences.publish: true</code> + Turso
            creds).
          </p>
        ) : (
          <>
            {/* Funnel KPIs */}
            <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
              {[
                ['Applied', funnel?.applied_total ?? 0, ''],
                ['Responses', funnel?.responded ?? 0, ''],
                ['Response rate', `${funnel?.response_rate ?? 0}%`, ''],
                ['Offers', funnel?.offers ?? 0, funnel?.offers ? 'text-emerald-300' : ''],
              ].map(([label, value, tone]) => (
                <div class="rounded-xl border border-border bg-bg-elevated/40 p-4">
                  <div class={'text-2xl font-medium tabular-nums ' + (tone || '')}>{value}</div>
                  <div class="mt-1 font-mono text-[11px] uppercase tracking-wider text-text-subtle">
                    {label}
                  </div>
                </div>
              ))}
            </section>

            {/* Pipeline chips */}
            <section class="mt-4 flex flex-wrap gap-2">
              {pipeline.map(([s, n]) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-bg-elevated/40 px-3 py-1 text-xs text-text-muted">
                  <b class="tabular-nums text-text">{n}</b> {s}
                </span>
              ))}
            </section>

            {/* Data tables (sort + filter) — one React island. */}
            <AdminTables
              client:load
              today={snap.today}
              matches={snap.matches ?? []}
              matchesTotal={snap.matches_total ?? 0}
              applications={snap.applications}
            />

            {/* Follow-ups */}
            {snap.followups.length > 0 && (
              <>
                <h2 class="mb-2.5 mt-9 font-mono text-[11px] uppercase tracking-wider text-text-subtle">
                  Follow-ups due · {snap.followups.length}
                </h2>
                <ul class="space-y-1.5 text-sm">
                  {snap.followups.map((f) => (
                    <li class="flex items-baseline justify-between gap-3 rounded-lg border border-border bg-bg-elevated/40 px-4 py-2.5">
                      <span>
                        {f.company} <span class="text-text-muted">· {f.title}</span>
                      </span>
                      <span class="shrink-0 font-mono text-xs text-text-subtle">
                        {f.applied_days_ago}d ago
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </>
        )
      }
    </main>

    <script is:inline>
      document.getElementById('logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/sign-out', { method: 'POST' });
        location.href = '/admin/login';
      });
    </script>
  </body>
</html>

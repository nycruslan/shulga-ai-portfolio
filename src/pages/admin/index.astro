---
export const prerender = false;
import AdminShell from '../../layouts/AdminShell.astro';
import { turso } from '../../lib/turso-client';
import { listPlaygroundConfigs, readSnapshot, readTraderSnapshot } from '../../lib/turso';
import { listProposals } from '../../lib/bridge/persistence/proposals';
import { relativeTime } from '../../lib/relative-time';
import { LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL } from 'astro:env/server';
import { readTwinConfig, completeness } from '../../lib/twin-config';

const twinConfigured = Boolean(LIVEKIT_URL && LIVEKIT_API_KEY && LIVEKIT_API_SECRET);
const twinScore = twinConfigured ? completeness(await readTwinConfig()) : 0;

// The owner hub: every admin feature as a card with a live stat, so a glance
// tells you what needs attention. Middleware guarantees only the owner is here.
const [job, traderResult, pgConfigs, pending] = await Promise.all([
  readSnapshot().catch(() => null),
  readTraderSnapshot().catch(() => null),
  listPlaygroundConfigs().catch(() => []),
  turso ? listProposals(turso, 'pending').catch(() => []) : Promise.resolve([]),
]);
// readTraderSnapshot now returns a discriminated result; the hub only needs the
// snapshot when it's actually there.
const trade = traderResult?.status === 'ok' ? traderResult.snap : null;

const tradeUpdated = trade?.generated_at ? new Date(trade.generated_at) : null;
const tradeStaleMin = tradeUpdated ? (Date.now() - tradeUpdated.getTime()) / 60000 : null;

type Feature = {
  href: string;
  label: string;
  name: string;
  desc: string;
  stat: string;
  alert: boolean;
};

const features: Feature[] = [
  {
    href: '/admin/jobhunt',
    label: 'Job search',
    name: 'JobHunt',
    desc: 'Application pipeline, response funnel, and follow-ups due.',
    stat: job
      ? `${job.funnel.applied_total} applied · ${job.funnel.response_rate}% response`
      : 'no snapshot yet',
    alert: !!job?.followups?.length,
  },
  {
    href: '/admin/trader',
    label: 'Markets',
    name: 'AI Trader',
    desc: 'Paper books, market regime, learning, and reflections.',
    stat: trade?.generated_at ? `updated ${relativeTime(trade.generated_at)}` : 'no snapshot yet',
    alert: tradeStaleMin != null && tradeStaleMin > 25,
  },
  {
    href: '/admin/playground',
    label: 'Markets',
    name: 'Trade Playground',
    desc: 'Create paper portfolios with your own rules and let them race.',
    stat: (() => {
      const n = pgConfigs.filter((p) => p.status === 'active').length;
      return n ? `${n} active portfolio${n === 1 ? '' : 's'}` : 'none yet — create one';
    })(),
    alert: false,
  },
  {
    href: '/admin/twin',
    label: 'Voice',
    name: 'Twin',
    desc: 'Talk to a realtime video avatar. Speech in, speech out, with a face.',
    // Setup completeness, not liveness: whether a worker is registered is only
    // knowable by dispatching, which would start a billable session just to
    // draw a card.
    stat: !twinConfigured ? 'not configured' : `${twinScore}/100 set up`,
    alert: twinConfigured && twinScore < 50,
  },
  {
    href: '/admin/system',
    label: 'Reference',
    name: 'How It Works',
    desc: 'Every formula, book, rail and exit rule behind the trading system.',
    stat: '9 books · read from the source',
    alert: false,
  },
  {
    href: '/admin/bridge',
    label: 'The Bridge',
    name: 'Copy sign-off',
    desc: "Approve or reject Curator's site-copy commits.",
    stat: pending.length ? `${pending.length} awaiting your sign-off` : 'nothing pending',
    alert: pending.length > 0,
  },
];
---

<AdminShell title="Console" home>
  <div class="mb-8">
    <h1 class="font-display text-2xl" style="letter-spacing: -0.02em;">Owner console</h1>
    <p class="text-text-muted mt-1.5 text-sm">Your private tools. Pick a console to open.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <a
          href={f.href}
          class="group border-border bg-bg-elevated/40 hover:border-accent-dim relative flex flex-col rounded-xl border p-6 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/[0.02]"
        >
          <div class="flex items-center justify-between">
            <span class="text-text-subtle font-mono text-[10px] tracking-widest uppercase">
              {f.label}
            </span>
            <span
              aria-hidden="true"
              class={'size-1.5 rounded-full ' + (f.alert ? 'bg-accent' : 'bg-border-strong')}
              style={f.alert ? 'box-shadow: 0 0 8px var(--color-accent);' : ''}
            />
          </div>
          <h2 class="font-display mt-4 text-xl" style="letter-spacing: -0.01em;">
            {f.name}
          </h2>
          <p class="text-text-muted mt-1.5 flex-1 text-sm leading-relaxed">{f.desc}</p>
          <div class="mt-5 flex items-center justify-between font-mono text-xs">
            <span class={f.alert ? 'text-accent' : 'text-text-subtle'}>{f.stat}</span>
            <span
              aria-hidden="true"
              class="text-accent transition-transform duration-200 group-hover:translate-x-0.5"
            >
              →
            </span>
          </div>
        </a>
      ))
    }
  </div>
</AdminShell>

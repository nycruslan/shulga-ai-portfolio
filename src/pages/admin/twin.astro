---
export const prerender = false;
import AdminShell from '../../layouts/AdminShell.astro';
import TwinConsole from '../../components/admin/TwinConsole.tsx';
import { LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL } from 'astro:env/server';
import { readTwinConfig, completeness } from '../../lib/twin-config';

// Middleware guarantees only the owner reaches /admin/*.
// The avatar and the LLM live in a separate Python agent worker registered
// with the same LiveKit project. This page only opens a room; if no worker is
// running, the session starts and nobody joins it.
const configured = Boolean(LIVEKIT_URL && LIVEKIT_API_KEY && LIVEKIT_API_SECRET);
const project = LIVEKIT_URL ? LIVEKIT_URL.replace(/^wss:\/\//, '') : null;

const twin = await readTwinConfig();
const score = completeness(twin);
---

<AdminShell title="Twin">
  {
    project && (
      <span slot="meta" class="text-text-subtle hidden text-xs sm:inline">
        {project}
      </span>
    )
  }

  <div class="mb-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl" style="letter-spacing: -0.02em;">Twin</h1>
      <p class="text-text-muted mt-1.5 text-sm">
        A realtime video avatar you can talk to. Speech in, speech out, with a face attached.
      </p>
    </div>
    <a
      href="/admin/twin/setup"
      class="border-border-strong hover:border-accent-dim shrink-0 rounded-lg border px-4 py-2 font-mono text-xs tracking-wide transition-colors"
    >
      Setup · {score}/100
    </a>
  </div>

  {
    configured && score < 50 && (
      <p class="text-text-subtle mt-4 font-mono text-xs leading-relaxed">
        Using the default face, voice and persona.
        <a href="/admin/twin/setup" class="text-accent">
          Set yours up
        </a>{' '}
        to make it sound like you.
      </p>
    )
  }

  {
    configured ? (
      <TwinConsole client:only="react" />
    ) : (
      <div class="border-border bg-bg-elevated/40 mt-8 rounded-xl border px-6 py-14 text-center">
        <h2 class="font-display text-xl" style="letter-spacing: -0.01em;">
          Not configured
        </h2>
        <p class="text-text-muted mx-auto mt-2 max-w-md text-sm leading-relaxed">
          Set <code class="font-mono text-xs">LIVEKIT_URL</code>,
          <code class="font-mono text-xs">LIVEKIT_API_KEY</code> and
          <code class="font-mono text-xs">LIVEKIT_API_SECRET</code> to enable this console. Every
          other admin tool works without them.
        </p>
      </div>
    )
  }

  <div class="border-border mt-10 border-t pt-6">
    <h2 class="font-mono text-[10px] tracking-widest text-text-subtle uppercase">How this runs</h2>
    <p class="text-text-muted mt-3 max-w-2xl text-sm leading-relaxed">
      This page mints a room token and dispatches an agent. It does not run the avatar or the model.
      A Python worker registered under the same agent name does that, joining the room and bringing
      the avatar with it. Start the worker before opening a session, or the room will sit empty.
      <span class="text-text-subtle">
        The avatar joins as a second participant of kind <code class="font-mono text-xs">agent</code
        >
        carrying <code class="font-mono text-xs">lk.publish_on_behalf</code>; that attribute is how
        the UI knows to render its video as the agent's face.
      </span>
    </p>
  </div>
</AdminShell>

---
export const prerender = false;
import '../../styles/global.css';
import AdminLogin from '../../components/islands/AdminLogin.tsx';
import { auth } from '../../lib/auth';

const configured = Boolean(auth);
const signedIn = Boolean(auth && Astro.locals.user);
const email = Astro.locals.user?.email ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>JobHunt · Admin</title>
    <style is:global>
      @media (pointer: fine) {
        html * {
          cursor: auto !important;
        }
      }
    </style>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-bg px-5 text-text antialiased">
    <main class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <div class="font-mono text-sm uppercase tracking-[0.18em]">JobHunt</div>
        <p class="mt-1.5 text-xs text-text-subtle">Owner access</p>
      </div>
      <div class="rounded-2xl border border-border bg-bg-elevated/40 p-6">
        {
          configured ? (
            <AdminLogin client:load signedIn={signedIn} email={email} />
          ) : (
            <p class="text-sm text-text-muted">Admin is not configured yet. See SETUP-ADMIN.md.</p>
          )
        }
      </div>
    </main>
  </body>
</html>

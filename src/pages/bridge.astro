---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import BridgeView from '../components/islands/BridgeView.tsx';
import BriefingRoom from '../components/islands/BriefingRoom.tsx';
import { AI_GATEWAY_API_KEY } from 'astro:env/server';
import { turso } from '../lib/turso-client';
import { bridgeStore } from '../lib/bridge/store';
import { listEvents } from '../lib/bridge/persistence/events';
import { daySpend } from '../lib/bridge/persistence/budget';
import { listMissions } from '../lib/bridge/persistence/missions';
import { buildBridgeFeed } from '../lib/bridge/feed';
import curated from '../data/curated.json';

// The Bridge, receipts-first. The page server-renders the premise and the
// first feed payload (instant first paint, no fetch waterfall); the island
// takes over from there with the live poll + wake tick.

const nowIso = new Date().toISOString();
const [row, events, spend, missions] = turso
  ? await Promise.all([
      bridgeStore.readState(),
      listEvents(turso, { limit: 40 }),
      daySpend(turso, nowIso),
      listMissions(turso, 8),
    ])
  : [null, [], { llmCalls: 0, inputTokens: 0, outputTokens: 0, costUsd: 0 }, []];

const initial = buildBridgeFeed({
  row,
  events,
  spend,
  nowIso,
  missions,
  commsOnline: !!AI_GATEWAY_API_KEY || import.meta.env.DEV,
});
---

<Layout
  title="The Bridge · Ruslan Shulga"
  description="This site maintains itself. Five AI agents watch the real GitHub feed, audit the copy, draft fixes behind human approval, and ship them as real commits. Every entry is timestamped and real."
  hideAskMe
>
  <Nav />
  <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-6 pt-16 pb-28 md:pt-24">
    <p
      class="mb-6 font-mono text-xs tracking-widest uppercase"
      style="color: var(--color-text-subtle);"
    >
      The Bridge
    </p>

    <h1
      class="font-display max-w-3xl text-3xl font-medium md:text-5xl"
      style="color: var(--color-text); letter-spacing: -0.02em;"
    >
      This site maintains itself.
    </h1>

    <p
      class="mt-6 max-w-2xl text-base leading-relaxed md:text-lg"
      style="color: var(--color-text-muted);"
    >
      A small crew of AI agents does the upkeep here. It watches my GitHub and audits the site's
      copy against my own writing rules. When something needs fixing it drafts the change, and after
      I approve from my phone the fix ships as a real commit.
    </p>

    <!-- Editable copy registry: this paragraph is owned by the crew. Critic
         audits it, Curator drafts fixes, Ruslan approves, and the change ships
         as a real commit to src/data/curated.json. -->
    <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color: var(--color-text-muted);">
      {curated.bridge_intro}
    </p>

    <div class="mt-10">
      <BridgeView client:only="react" initial={initial}>
        <div
          slot="fallback"
          class="rounded-lg p-6 font-mono text-sm"
          style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-subtle);"
        >
          Loading the work log…
        </div>
      </BridgeView>
    </div>

    <section
      class="mt-12 rounded-lg p-5"
      style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);"
      aria-label="Recruiter briefing, assembled live"
    >
      <p
        class="mb-4 font-mono text-[10px] tracking-widest uppercase"
        style="color: var(--color-text-subtle);"
      >
        Recruiter briefing — assembled live from real case studies
      </p>
      <BriefingRoom client:only="react" online={initial.commsOnline}>
        <p slot="fallback" class="font-mono text-xs" style="color: var(--color-text-subtle);">
          Opening the briefing desk…
        </p>
      </BriefingRoom>
    </section>
  </main>
</Layout>
